GEMINI_API_KEY=your_google_ai_studio_key_here
EXA_API_KEY=your_exa_api_key_here
DATABASE_URL=postgres://avnadmin:password@host:port/defaultdb?sslmode=require

# Optional: Gemini models to try in order. Each has its own free-tier daily quota.
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional API budget guards (defaults shown). Chilly stops before exceeding these.
# BUTLER_EXA_DAILY_USD=1
# BUTLER_EXA_DAILY_SEARCHES=60
# BUTLER_GEMINI_DAILY_CALLS=120
# BUTLER_TASK_MAX_SEARCHES=5
# BUTLER_TASK_MAX_DRAFTS=4
# BUTLER_EXA_ESTIMATE_USD=0.01
# BUTLER_EXA_DEEP_ESTIMATE_USD=0.02
# BUTLER_EXA_MAX_AGE_HOURS=24

# Telegram notifications. Create a bot with @BotFather; each browser connects its own chat.
# TELEGRAM_BOT_TOKEN=123456:your_bot_token

# Background watches
# BUTLER_MAX_WATCHES=3
# BUTLER_WATCH_EVERY_HOURS=24
# BUTLER_REMINDER_LEAD_MIN=10
